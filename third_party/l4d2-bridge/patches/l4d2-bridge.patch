+}
+class Scope {
+  Metric m_metric;
+  unsigned long long m_bytes;
+  LARGE_INTEGER m_start{};
+  bool m_active;
+public:
+  explicit Scope(Metric metric, unsigned long long size = 0)
+    : m_metric(metric), m_bytes(size), m_active(enabled.load(std::memory_order_relaxed)) {
+    if (m_active) { QueryPerformanceCounter(&m_start); }
+  }
+  void addBytes(unsigned long long size) { m_bytes += size; }
+  ~Scope() {
+    if (!m_active) { return; }
+    LARGE_INTEGER end{};
+    QueryPerformanceCounter(&end);
+    const auto duration = static_cast<unsigned long long>(end.QuadPart - m_start.QuadPart);
+    calls[m_metric].fetch_add(1, std::memory_order_relaxed);
+    ticks[m_metric].fetch_add(duration, std::memory_order_relaxed);
+    bytes[m_metric].fetch_add(m_bytes, std::memory_order_relaxed);
+    auto peak = peaks[m_metric].load(std::memory_order_relaxed);
+    while (peak < duration && !peaks[m_metric].compare_exchange_weak(peak, duration)) {}
+    static std::atomic<ULONGLONG> next{0};
+    const auto now = GetTickCount64();
+    auto deadline = next.load();
+    if (now >= deadline && next.compare_exchange_strong(deadline, now + 5000)) { flush(); }
+  }
+};
